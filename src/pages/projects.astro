---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import { projects } from "../data/generated";
---

<BaseLayout title="项目 · 日暮途远" active="projects">
  <div class="wrap page-enter">
    <section class="sec" style="margin-top: 60px;">
      <SectionHead hand="做过的项目" en="PROJECTS" />
      <div class="proj-grid">
        {projects.map((project) => (
          <a class="pcard reveal" href={project.github} target="_blank" rel="noopener">
            <span class="stamp">{project.status}</span>
            <h3>{project.name}</h3>
            <div class="sub">{project.sub}</div>
            <p>{project.desc}</p>
            <div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
            <div style="margin-top: 18px; font-family: 'Quicksand',sans-serif; font-size: 12px; color: var(--ink-soft);">
              {project.stack}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
