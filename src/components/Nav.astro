---
interface Props {
  active?: "home" | "novels" | "essays" | "projects" | "about";
}

const { active = "home" } = Astro.props;
const items = [
  { id: "home", label: "首页", href: "/" },
  { id: "novels", label: "小说", href: "/novels/" },
  { id: "essays", label: "随笔", href: "/essays/" },
  { id: "projects", label: "项目", href: "/projects/" },
  { id: "about", label: "关于", href: "/about/" },
] as const;
---

<nav class="top">
  <div class="inner">
    <a class="brand" href="/">日暮途远</a>
    <ul>
      {items.map((item) => (
        <li>
          <a class={active === item.id ? "active" : ""} href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>
